{
  "name": "lms-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "pretest": "NODE_ENV=test npm run db:migrate",
    "test": "mocha tests/**/*.js --exit --recursive --timeout 60000 --file ./tests/test-setup.js",
    "start": "node index.js",
    "server": "nodemon -r dotenv/config index.js",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo",
    "db:seed:all": "sequelize db:seed:all",
    "db:seed:undo:all": "sequelize db:seed:undo:all",
    "db:seed": "sequelize db:seed --seed",
    "db:seed:undo": "sequelize db:seed:undo",
    "migration:generate": "sequelize migration:generate --name"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.10.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.14",
    "pg": "^8.7.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.11.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "chai": "^4.3.4",
    "mocha": "^11.7.6",
    "sequelize-cli": "^6.6.5",
    "sinon": "^22.0.0",
    "supertest": "^7.2.2"
  }
}
